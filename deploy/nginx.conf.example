# /etc/nginx/sites-available/truffles-api   (replace api.example.com, then: sudo certbot --nginx -d api.example.com)
# The Node app listens only on 127.0.0.1:5001; nginx is the single public entry point.
server {
    listen 80;
    server_name api.example.com;

    # certbot rewrites this block to redirect to https and adds the certificate.
    client_max_body_size 200k;

    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append client-supplied values
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
