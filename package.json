{
  "name": "truffles-cafe-backend",
  "version": "1.0.0",
  "description": "Enterprise Express REST API for Truffles Cafe & Restaurant",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "hash-password": "node scripts/hash-password.mjs",
    "security:check": "node scripts/security-check.mjs",
    "audit": "npm audit --omit=dev",
    "security:ci": "bash scripts/ci-security.sh",
    "test:dashboard": "node scripts/dashboard-smoke.mjs"
  },
  "keywords": [
    "express",
    "restaurant",
    "typescript",
    "api"
  ],
  "author": "Truffles Cafe Team",
  "license": "ISC",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
