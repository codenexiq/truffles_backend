# ============================================================
# Truffles API configuration.  Copy to .env and fill in.
# NEVER commit the real .env.  Never share it.
# ============================================================

NODE_ENV=development
PORT=5001
# Only this machine can connect directly (nginx forwards public traffic). Use 0.0.0.0 only if you know why.
HOST=127.0.0.1
API_PREFIX=/api/v1

# Website origin(s) allowed to call this API (comma-separated). Production must be https.
# Example: CLIENT_URL=https://trufflescafe.com,https://www.trufflescafe.com
CLIENT_URL=http://localhost:3000

# Reverse-proxy hops to trust for client IPs (0 = none; 1 behind nginx / a load balancer)
TRUST_PROXY=0

# REQUIRED in production, at least 32 characters, random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server refuses to start in production without a strong secret.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# First admin account. Create the hash with:  npm run hash-password
# (In development, if these are empty, a random admin password is printed at startup.)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Request limits
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
PUBLIC_WRITE_MAX=10

# Email (SMTP) - not used yet
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Truffles Rooftop Restaurant" <reservations@your-domain.com>
